{
  "name": "praying-hands-wellness-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build-css": "less-watch-compiler --run-once --main-file=app.less src/styles/ public/css/",
    "watch-css": "npm run build-css && less-watch-compiler --main-file=app.less src/styles/ public/css/",
    "build": "npm run build-css && react-scripts build",
    "heroku-postbuild": "npm run build",
    "render-build": "npm install && npm run build",
    "script-run": "react-scripts start",
    "script-dev": "concurrently \"npm run watch-css\" \"npm run script-run\" \"wait-on http://localhost:3001\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@apollo/client": "^3.11.10",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@react-oauth/google": "^0.12.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/lodash": "^4.17.13",
    "@types/node": "^16.18.119",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-slick": "^0.23.13",
    "apollo-server-express": "^3.13.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "flickr-sdk": "^7.0.0-beta.9",
    "googleapis": "^144.0.0",
    "html-react-parser": "^5.1.18",
    "jsonwebtoken": "^9.0.2",
    "ldrs": "^1.0.2",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "mongodb": "^6.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-modal-sheet": "^3.3.0",
    "react-quill-new": "^3.3.3",
    "react-router-dom": "^7.0.1",
    "react-scripts": "5.0.1",
    "react-slick": "^0.30.2",
    "react-toastify": "^10.0.6",
    "rodal": "^2.1.0",
    "slick-carousel": "^1.8.1",
    "typescript": "^4.9.5",
    "uuid": "^11.0.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/leaflet": "^1.9.15",
    "concurrently": "^8.2.1",
    "less": "^4.2.0",
    "less-loader": "^11.1.3",
    "less-watch-compiler": "^1.16.3"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
